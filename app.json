{
  "expo": {
    "name": "reactNativeStudy",
    "slug": "stockNewsApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reactnativestudy",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reactNativeStudy.mobile",
      "associatedDomains": ["applinks:stocknews.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "카메라 사용 권한 필요",
        "NSPhotoLibraryUsageDescription": "사진 보관함 접근 권한 필요",
        "NSLocationWhenInUseUsageDescription": "위치 정보 사용 권한 필요"
      }
    },
    "android": {
      "package": "com.stocknewsapp.mobile",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "stocknews.com",
              "pathPrefix": "/detail"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c6f5288-ee8b-441b-a64f-f17155fdb490"
      }
    }
  }
}
